# Model Configuration
MODEL_PROVIDER=ollama # or deepseek or openai
MODEL_NAME=qwen2.5 # for ollama, or model name for other providers
TEMPERATURE=0.7

# Ollama Configuration (required if MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# DeepSeek Configuration (required if MODEL_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your_api_key_here

# OpenAI Configuration (required if MODEL_PROVIDER=openai)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1 # Optional, defaults to OpenAI's API

# Project Configuration
WORKSPACE_ROOT=/path/to/your/workspace # Optional, defaults to current directory 